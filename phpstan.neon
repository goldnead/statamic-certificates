includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5

    paths:
        - src
        - database
        - config

    treatPhpDocTypesAsCertain: false

    # Larastan only knows the host app's config directory; this is the
    # package's own, where env() is exactly right.
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/certificates.php
